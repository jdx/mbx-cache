MISE_CACHE_STORAGE="s3"
MISE_CACHE_DATABASE_URL="postgres://mise_cache:replace-with-a-url-safe-password@postgres/mise_cache"
MISE_CACHE_S3_BUCKET="mise-cache-production"
MISE_CACHE_S3_PREFIX="v1"
