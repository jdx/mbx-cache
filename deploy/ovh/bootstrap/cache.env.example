MISE_CACHE_S3_REGION="auto"
MISE_CACHE_S3_PATH_STYLE="true"
MISE_CACHE_OIDC_PROVIDERS_JSON="[]"
MISE_CACHE_ALLOW_ANONYMOUS="false"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"
