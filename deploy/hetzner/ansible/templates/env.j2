MISE_CACHE_STORAGE=s3
MISE_CACHE_DATABASE_URL=postgres://mise_cache:{{ database_password }}@postgres/mise_cache
MISE_CACHE_S3_BUCKET={{ object_storage_bucket }}
MISE_CACHE_S3_PREFIX=v1
MISE_CACHE_S3_ENDPOINT=https://{{ object_storage_location }}.your-objectstorage.com
MISE_CACHE_S3_REGION={{ object_storage_location }}
MISE_CACHE_S3_PATH_STYLE=true
MISE_CACHE_OIDC_PROVIDERS_JSON='{{ oidc_providers | to_json }}'
MISE_CACHE_ALLOW_ANONYMOUS=false
AWS_ACCESS_KEY_ID='{{ object_storage_access_key }}'
AWS_SECRET_ACCESS_KEY='{{ object_storage_secret_key }}'
